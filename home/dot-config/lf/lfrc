set hidden
set promptfmt "\033[1;36m%d\033[0;1m%f\033[0m"
set nopreview
set ratios 1
set info size:time
set dircounts

# Open text files in $EDITOR, anything else with the system opener
cmd open ${{
  case $(file --mime-type -Lb "$f") in
    text/*|application/json|inode/x-empty) $EDITOR "$f" ;;
    *) $OPENER "$f" >/dev/null 2>&1 & ;;
  esac
}}

# BÉPO, following nvim/config/bepo.vim
# [HJKL] -> {CTSR}
map c updir
map t down
map s up
map r open
map C high
map R low

# {HJKL} <- [CTSR]
map h mark-save
map j tag-toggle
map l clear

# k replaces s as the sort prefix (s alone must not wait for a second key)
map sn
map ss
map st
map sa
map sb
map sc
map se
map k
map kn set sortby natural
map ks set sortby size
map kt set sortby time
map ka set sortby atime
map kb set sortby btime
map kc set sortby ctime
map ke set sortby ext

# Fern-like file management
map m rename
map D delete
map x trash
map <enter> open
nmap v visual
vmap v visual-accept
nmap V invert
map n push :new<space>
cmd q quit # :q, like vim

# Move selection (or current file) to the macOS Trash
cmd trash %{{
  IFS='
'
  trash $fx
}}

# Create a file, or directories with a trailing /, creating missing parents:
# "a/b c/d" gives directories a and "b c", then file d, and selects it;
# "a/b/" only creates directories and stays here, on a
cmd new %{{
  p="$*"
  case $p in
    */) mkdir -p -- "$p" && sel=${p%%/*} ;;
    *) mkdir -p -- "$(dirname -- "$p")" && touch -- "$p" && sel=$p ;;
  esac || exit
  [ -n "$sel" ] || exit # absolute directory path: nothing to select here
  case $sel in /*) ;; *) sel="$PWD/$sel" ;; esac
  lf -remote "send $id select \"$sel\""
}}
