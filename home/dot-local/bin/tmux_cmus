#!/usr/bin/env bash

# cmus status for the tmux status bar: "[‣] Artist - Title"

status=$(cmus-remote -Q 2>/dev/null) || { echo "[!]"; exit; }

state=$(sed -n 's/^status //p' <<< "$status")
artist=$(sed -n 's/^tag artist //p' <<< "$status")
title=$(sed -n 's/^tag title //p' <<< "$status")

case $state in
  playing) echo "[‣] ${artist:0:20} - ${title:0:30}" ;;
  paused)  echo "[⏸] ${artist:0:20} - ${title:0:30}" ;;
  *)       echo "[⏹]" ;;
esac
