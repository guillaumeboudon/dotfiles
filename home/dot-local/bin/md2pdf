#!/usr/bin/env zsh

# Markdown to PDF with a typst template: md2pdf [TEMPLATE] FILE.md [pandoc args, e.g. --toc]
# TEMPLATE is a directory of ~/.config/md2pdf holding charte.typ and its assets;
# without it, pandoc's default typst style is used.
# Prints the path of the generated PDF on success.

templates="${XDG_CONFIG_HOME:-$HOME/.config}/md2pdf"

if [[ -z "$1" ]]; then
  echo "Usage: md2pdf [TEMPLATE] FILE.md [pandoc args]" >&2
  echo "Templates: ${(j:, :)${(@f)$(ls "$templates")}}" >&2
  exit 1
fi

style=()
if [[ ! -f "$1" ]]; then
  assets="$templates/$1"
  if [[ ! -f "$assets/charte.typ" ]]; then
    echo "md2pdf: unknown template '$1'" >&2
    exit 1
  fi
  style=(--pdf-engine-opt=--input=assets="$assets" -H "$assets/charte.typ")
  shift
fi

pdf="${${1:A}%.md}.pdf"

pandoc "$1" -o "$pdf" \
  -f markdown+emoji+mark+autolink_bare_uris --columns=1000 \
  --pdf-engine=typst --syntax-highlighting=idiomatic \
  --pdf-engine-opt=--root=/ "${style[@]}" "${@:2}" \
  && echo "$pdf"
