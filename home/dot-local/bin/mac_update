#!/usr/bin/env bash

cd ~ || exit 1

echo -e "Update \"brew\"\n============="
brew update

echo -e "\nUpdate applications\n==================="
brew upgrade --greedy

echo -e "\nCleanup!\n========"
brew cleanup -s

echo -e "\nReportings\n=========="
echo "> Doctor?"
brew doctor
echo "> Anything missing?"
brew missing

echo -e "\nUpdate applications from App Store\n=================================="
echo "> Check"
mas outdated
echo "> Update"
mas upgrade

echo -e "\nUpdate gems\n==========="
gem update
