#!/usr/bin/env bash

# Claude Code status line, styled like the starship prompt:
#   .dotfiles  main | Opus 5.5 (high) | Ctx ▓▓▓░░░░░░░ 35% | Use ▓▓░░░░░░░░ 24% ↻19:30
# Reads the session JSON on stdin (https://code.claude.com/docs/en/statusline).
# Colors are ANSI 0-15, so they follow the base16 terminal palette.

IFS=$'\x1f' read -r dir model effort ctx quota reset < <(jq -r '[
  .workspace.current_dir,
  .model.display_name,
  (.effort.level // ""),
  (.context_window.used_percentage // 0 | floor),
  (.rate_limits.five_hour.used_percentage // "" | if . == "" then . else floor end),
  (.rate_limits.five_hour.resets_at // "")
] | map(tostring) | join("\u001f")')

white=$'\033[97m' cyan=$'\033[1;36m' purple=$'\033[1;35m' reset_color=$'\033[0m'
branch_symbol=$'\xee\x82\xa0' # U+E0A0, Powerline branch glyph (in Iosevka), as in starship
sep=" ${white}|${reset_color} "

# Green below 50%, yellow below 80%, red above
level_color() {
  if (( $1 < 50 )); then printf '\033[32m'; elif (( $1 < 80 )); then printf '\033[33m'; else printf '\033[31m'; fi
}

# "Ctx ▓▓▓░░░░░░░ 35%": 10-cell gauge, one cell per 10% (rounded)
gauge() {
  local label=$1 pct=$2 filled=$(( ($2 + 5) / 10 )) bar="" i
  (( filled > 10 )) && filled=10
  for (( i = 0; i < 10; i++ )); do
    (( i < filled )) && bar+="▓" || bar+="░"
  done
  printf '%s%s %s%s %s%%%s' "$white" "$label" "$(level_color "$pct")" "$bar" "$pct" "$reset_color"
}

# Effort in the colors of Claude Code's /effort picker: low yellow, medium green,
# high blue, xhigh magenta, max bold rainbow (one color per letter)
effort_label() {
  local rainbow=(31 '38;5;16' 33 32 36 34 35) i out=""
  case $1 in
    low)    printf '\033[33m%s' "$1" ;;
    medium) printf '\033[32m%s' "$1" ;;
    high)   printf '\033[34m%s' "$1" ;;
    xhigh)  printf '\033[35m%s' "$1" ;;
    max)
      for (( i = 0; i < ${#1}; i++ )); do
        out+="\033[1;${rainbow[i % 7]}m${1:i:1}"
      done
      printf '%b' "$out" ;;
    *)      printf '%s%s' "$white" "$1" ;;
  esac
  printf '%s' "$reset_color"
}

# Path: git project name, or ~-relative path with /.../ when deeper than 5 parts
location() {
  local top branch path parts
  { read -r top; read -r branch; } < <(git -C "$dir" --no-optional-locks rev-parse --show-toplevel --abbrev-ref HEAD 2>/dev/null)
  if [[ -n $top ]]; then
    printf '%s%s%s %s%s %s%s' "$cyan" "${top##*/}" "$reset_color" "$purple" "$branch_symbol" "$branch" "$reset_color"
    return
  fi
  path=${dir/#$HOME/\~}
  IFS=/ read -r -a parts <<< "$path"
  if (( ${#parts[@]} > 5 )); then
    path="${parts[0]}/${parts[1]}/.../${parts[${#parts[@]}-2]}/${parts[${#parts[@]}-1]}"
  fi
  printf '%s%s%s' "$cyan" "$path" "$reset_color"
}

out="$(location)${sep}${white}${model}${reset_color}${effort:+ ${white}(${reset_color}$(effort_label "$effort")${white})${reset_color}}"
out+="${sep}$(gauge Ctx "$ctx")"

if [[ -n $quota ]]; then
  time=$(date -r "$reset" +%H:%M 2>/dev/null || date -d "@$reset" +%H:%M 2>/dev/null)
  out+="${sep}$(gauge Use "$quota")${time:+ ${white}↻${time}${reset_color}}"
fi

printf '%s\n' "$out"
