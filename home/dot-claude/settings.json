{
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(cat *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(git blame *)",
      "Bash(git branch *)",
      "Bash(git commit *)",
      "Bash(git commit)",
      "Bash(git config --get *)",
      "Bash(git describe *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git ls-files *)",
      "Bash(git pull *)",
      "Bash(git reflog *)",
      "Bash(git remote -v)",
      "Bash(git rev-parse *)",
      "Bash(git shortlog *)",
      "Bash(git show *)",
      "Bash(git stash list*)",
      "Bash(git status *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(rg *)",
      "Bash(tail *)",
      "Bash(tree *)",
      "Bash(wc *)",
      "Bash(which *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(rm -f *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(shred *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(netcat *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -xfd *)",
      "Bash(heroku *)",
      "Bash(scalingo *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); msg=$(printf '%s' \"$input\" | jq -r '.message // \"Claude requiert ton attention\"'); dir=$(basename \"$(printf '%s' \"$input\" | jq -r '.cwd // \"\"')\"); /opt/homebrew/bin/terminal-notifier -title \"Claude Code\" -subtitle \"$dir\" -message \"$msg\" -sound Basso -sender com.anthropic.claudefordesktop 2>/dev/null || true",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.local/bin/claude_statusline"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "tui": "fullscreen",
  "preferredNotifChannel": "notifications_disabled",
  "additionalDirectories": []
}
